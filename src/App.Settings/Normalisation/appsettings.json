{
  "Normalisation": {
    "Settings": {
      "ServiceName": "Normalisation",
      "MaxTitleLength": 100,
      "MaxSummaryLength": 750,
      "MaxKeywordsLength": 3000,
      "MaxTags": 10,
      "MaxLinks": 100,
      "MaxLinksBytes": 65536,

      "AllowedLinkSchemes": [
        "http",
        "https"
      ],

      "LanguageDetectionFallbackIso2Code": "en",
      "LanguageDetectionFallbackIso3Code": "eng"
    }
  },

  "MetaCache": {
    "Container": "meta-cache",
    "Provider": "Memory", //Memory|Redis 
    "Redis": {
      "ConnectionString": ""
    }
  },

  "BlobCache": {
    "Container": "blob-cache",
    "Provider": "FileStorage", //FileStorage|BlobStorage
    "FileStorage": {
      "AbsoluteExpiryHours": 24
    },
    "BlobStorage": {
      "AbsoluteExpiryHours": 24,
      "ConnectionString": ""
    }
  },

  "Requests": {
    "RequestSender": {
      "CacheMinAbsoluteExpiryMinutes": 5,
      "CacheMaxAbsoluteExpiryMinutes": 20,
      "GroupKey": "normalisation-group"
    },

    "Provider": "HttpClient",
    "HttpClient": {
      "AllowAutoRedirect": true,
      "MaxAutomaticRedirections": 5,
      "TimeoutSeconds": 10,
      "RetryAfterFallbackMinutes": 5
    }
  }
}