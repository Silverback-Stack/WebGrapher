{
  "Scraper": {
    "Settings": {
      "ServiceName": "Scraper",
      "ContentMaxBytes": 8388608 //8 Mb
    }
  },


  "MetaCache": {
    "Container": "meta-cache",
    "Provider": "Memory", //Memory|Redis
    "Redis": {
      "ConnectionString": ""
    }
  },

  "BlobCache": {
    "Container": "blob-cache",
    "Provider": "FileStorage", //FileStorage|BlobStorage
    "FileStorage": {
      "AbsoluteExpiryHours": 24
    },
    "BlobStorage": {
      "AbsoluteExpiryHours": 24,
      "ConnectionString": ""
    }
  },

  "Requests": {
    "RequestSender": {
      "CacheMinAbsoluteExpiryMinutes": 5,
      "CacheMaxAbsoluteExpiryMinutes": 20,
      "GroupKey": "scraper-group"
    },

    "Provider": "HttpClient",
    "HttpClient": {
      "AllowAutoRedirect": true,
      "MaxAutomaticRedirections": 5,
      "TimeoutSeconds": 10,
      "RetryAfterFallbackMinutes": 5
    }
  },


  "PolicyCache": {
    "Container": "policy-cache",
    "Provider": "Memory", //Memory|Redis
    "Redis": {
      "ConnectionString": ""
    }
  },

  "SitePolicy": {
    "Settings": {
      "RobotsUserAccepts": "text/plain, text/html",
      "PolicyExpiryMinutes": 20
    }
  }
}